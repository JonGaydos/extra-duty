# The app's settings. With Docker Compose: copy to app.env (never commit it). Without Compose: copy to .env.local and
# also fill in the storage and database lines at the end. Every value below is a placeholder.
# Every setting: docs/operations.md.

APP_ENV=production  # production (the live site, with training mode) or staging (demo data; email kept in the outbox)
SEED_ADMIN_EMAIL=admin@example.com  # the first admin; the release step creates this account if it is missing
SECRETS_KEY=  # base64 of 32 random bytes: openssl rand -base64 32
FILE_MASTER_KEY=  # base64 of 32 random bytes, separate from SECRETS_KEY: openssl rand -base64 32 (encrypts W-9 files; see key rotation in docs/operations.md)
BETTER_AUTH_SECRET=  # at least 32 random characters: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000  # public base URL of the app (https://your-domain); links in emails use it
APP_URL=  # optional; links in alert emails use it, falling back to BETTER_AUTH_URL
STAGING_EMAIL_ALLOWLIST=  # staging only: comma-separated addresses that receive sign-in codes, invites and reset links; all other email stays in the outbox
VAPID_PUBLIC_KEY=  # web push keys: npx web-push generate-vapid-keys; push is skipped while unset
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=  # mailto:you@example.org

# --- File storage (W-9s, contracts, ops plans, logos). W-9s are encrypted by the app with either choice. ---
# Docker Compose: files go to a folder on disk (the files volume, /data/live and /data/training) and these lines
# stay commented out. Compose reads docker/storage.env first and app.env after it, so whatever is set here wins.
# For S3 storage (for example on a cloud host), uncomment and fill in STORAGE_DRIVER=s3 and the S3 lines.
# Without Compose: set STORAGE_DRIVER (production refuses to start without it) and either the two folders or S3.
# STORAGE_DRIVER=local  # local (a folder on disk) or s3 (any S3-compatible service, such as DigitalOcean Spaces or AWS)
# STORAGE_LOCAL_DIR=./var/storage  # live files when STORAGE_DRIVER=local; under Compose leave unset (it is /data/live)
# TRAINING_STORAGE_LOCAL_DIR=./var/training-storage  # training files when STORAGE_DRIVER=local; never the live folder
# S3_ENDPOINT=  # blank for AWS; set for S3-compatible hosts, e.g. https://nyc3.digitaloceanspaces.com
# S3_REGION=
# S3_BUCKET=
# TRAINING_BUCKET=  # training files when STORAGE_DRIVER=s3; never the live bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Without Docker Compose only (Compose sets these itself) ---
TRUSTED_PROXY=  # addresses or CIDR ranges of the reverse proxy whose X-Forwarded-For is believed; empty trusts no one
DATABASE_URL=postgres://user:password@localhost:5432/extra_duty
TRAINING_DATABASE_URL=  # the training copy's own database; empty turns training mode off
