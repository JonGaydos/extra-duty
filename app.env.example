# The app's settings. With Docker Compose: copy to app.env (never commit it). Without Compose: copy to .env.local and
# also fill in the storage and database lines at the end. Every value below is a placeholder.
# Keep each comment on its own line: Docker Compose reads text after a value, even after spaces, as part of it.
# Every setting: docs/operations.md.

# production (the live site, with training mode) or staging (demo data; email kept in the outbox).
APP_ENV=production
# The first admin; the release step creates this account if it is missing.
SEED_ADMIN_EMAIL=admin@example.com
# Base64 of 32 random bytes: openssl rand -base64 32
SECRETS_KEY=
# Base64 of 32 random bytes, separate from SECRETS_KEY: openssl rand -base64 32 (encrypts W-9 files; see key rotation
# in docs/operations.md).
FILE_MASTER_KEY=
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (https://your-domain); links in emails use it.
BETTER_AUTH_URL=http://localhost:3000
# Optional; links in alert emails use it, falling back to BETTER_AUTH_URL.
APP_URL=
# Staging only: comma-separated addresses that receive sign-in codes, invites and reset links; all other email stays
# in the outbox.
STAGING_EMAIL_ALLOWLIST=
# Web push keys (npx web-push generate-vapid-keys); push is skipped while unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Web push contact, such as mailto:you@example.org.
VAPID_SUBJECT=
# Map tiles. Unset: OpenStreetMap's free tile servers, which suit light use; a busier site should use a hosted tile
# provider. A tile address or attribution saved in Admin, Settings, Map wins over these.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- File storage (W-9s, contracts, ops plans, logos). W-9s are encrypted by the app with either choice. ---
# Docker Compose: files go to a folder on disk (the files volume, /data/live and /data/training) and these lines
# stay commented out. Compose reads docker/storage.env first and app.env after it, so whatever is set here wins.
# For S3 storage (for example on a cloud host), uncomment and fill in STORAGE_DRIVER=s3 and the S3 lines.
# Without Compose: set STORAGE_DRIVER (production refuses to start without it) and either the two folders or S3.
# local (a folder on disk) or s3 (any S3-compatible service, such as DigitalOcean Spaces or AWS).
# STORAGE_DRIVER=local
# Live files when STORAGE_DRIVER=local; under Compose leave unset (it is /data/live).
# STORAGE_LOCAL_DIR=./var/storage
# Training files when STORAGE_DRIVER=local; never the live folder.
# TRAINING_STORAGE_LOCAL_DIR=./var/training-storage
# Blank for AWS; set for S3-compatible hosts, e.g. https://nyc3.digitaloceanspaces.com.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# Training files when STORAGE_DRIVER=s3; never the live bucket.
# TRAINING_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Without Docker Compose only (Compose sets these itself) ---
# Addresses or CIDR ranges of the reverse proxy whose X-Forwarded-For is believed; empty trusts no one.
TRUSTED_PROXY=
DATABASE_URL=postgres://user:password@localhost:5432/extra_duty
# The training copy's own database; empty turns training mode off.
TRAINING_DATABASE_URL=
