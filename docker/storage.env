# File storage under Docker Compose: a folder on disk, the files volume mounted at /data in web, the worker and
# migrate. Compose reads this file before app.env, so a setting in app.env wins: for S3 storage, set
# STORAGE_DRIVER=s3 and the S3_* and TRAINING_BUCKET settings there. Do not edit this file; override in app.env.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/live
TRAINING_STORAGE_LOCAL_DIR=/data/training
