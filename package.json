{
  "name": "extra-duty",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:sonar": "eslint --config eslint.sonar.config.mjs src scripts tests",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "worker": "tsx --tsconfig tsconfig.node.json src/jobs/worker.ts",
    "db:migrate": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env.local src/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sesv2": "^3.1175.0",
    "@date-fns/tz": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.27",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "ical.js": "^2.2.1",
    "leaflet": "1.9.4",
    "next": "^15.5.29",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "uuidv7": "^1.2.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-sonarjs": "4.2.3",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
