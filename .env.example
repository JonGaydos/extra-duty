# Docker Compose's own settings. Copy to .env and fill in; never commit .env. Every value below is a placeholder.
# Keep each comment on its own line: Docker Compose reads text after a value, even after spaces, as part of it.
# Compose uses these to build the database settings. They never reach the web or worker containers: those get only
# app.env (copy app.env.example) and the app's limited database role.
# Guide: docs/self-hosting.md.

# Your domain name (extraduty.example.org) for HTTPS; plain-HTTP requests then redirect to it. Empty: plain HTTP on
# the local network only.
SITE_DOMAIN=
# Database owner, used only by the release step (migrate): openssl rand -hex 24
POSTGRES_PASSWORD=
# Database role the app runs as (rows only, no schema changes): openssl rand -hex 24
APP_DB_PASSWORD=

# Where uploaded files (W-9s, contracts, ops plans, logos) are kept on this machine. Unset: the Docker volume
# "files". Set to a host folder for a bind mount (on Unraid: /mnt/user/appdata/extra-duty/files); give the folder to
# the app's user first: chown -R 1000:1000 <the folder>. Ignored when app.env chooses S3 storage.
# FILES_PATH=

# Local development only; Compose and the app never read it. Export it in your shell before scripts/preview.sh or
# scripts/capture-local.sh to choose the demo accounts' password. Unset: a random password for each run, printed once.
# DEMO_PASSWORD=
