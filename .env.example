# Docker Compose's own settings. Copy to .env and fill in; never commit .env. Every value below is a placeholder.
# Compose uses these to build the database and storage settings. They never reach the web or worker containers:
# those get only app.env (copy app.env.example) and the app's limited database role and storage account.
# Guide: docs/self-hosting.md.

SITE_DOMAIN=  # your domain name (extraduty.example.org) for HTTPS; plain-HTTP requests then redirect to it. Empty: plain HTTP on the local network only
POSTGRES_PASSWORD=  # database owner, used only by the release step (migrate): openssl rand -hex 24
APP_DB_PASSWORD=  # database role the app runs as (rows only, no schema changes): openssl rand -hex 24
MINIO_ROOT_USER=extraduty  # file storage (MinIO) administrator, used only by MinIO and the buckets step
MINIO_ROOT_PASSWORD=  # at least 8 characters: openssl rand -hex 24
MINIO_APP_PASSWORD=  # the app's own storage account (extra-duty-app, the two app buckets only): openssl rand -hex 24
